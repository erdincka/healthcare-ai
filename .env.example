# Copy to .env for local development. .env is git-ignored; never commit it.
#
# The application itself reads none of these: endpoints, tokens, model names and the
# database connection string are entered in the Settings tab and persisted to
# /app/data/api_config.json on the pod's PersistentVolumeClaim. The Tilt dev loop reads
# tilt_config.json instead (copy tilt_config.example.json; see the readme's Development section).

# --- Reference values for the Settings tab (not read by the app) ---
STT_URL=https://nemotron-nano.project-demos.serving.ai-application.example.com
STT_TOKEN=replace-with-mlis-bearer-token
STT_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
STT_API_FORMAT=chat                        # "whisper" for /v1/audio/transcriptions servers
TRANSLATE_URL=https://ollama.ai-application.example.com
TRANSLATE_MODEL=translategemma:4b
MEDGEMMA_URL=https://ollama.ai-application.example.com
MEDGEMMA_MODEL=medgemma1.5:4b
DB_CONN=postgresql://postgres:replace-me@supabase-supabase-db.supabase.svc.cluster.local:5432/postgres

# --- Release build (run manually; needs Docker Hub push rights) ---
DOCKER_BUILD=docker build --platform linux/amd64 --target prod -t nexusglobal/triageai:1.2.4 --push ./frontend/docker
